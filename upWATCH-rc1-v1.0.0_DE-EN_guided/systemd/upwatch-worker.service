[Unit]
Description=upWATCH! Monitoring Worker
Wants=network-online.target
After=network-online.target postgresql.service
Requires=postgresql.service
[Service]
Type=simple
User=upwatch
Group=upwatch
WorkingDirectory=/opt/upwatch
EnvironmentFile=/etc/upwatch/upwatch.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/upwatch/.venv/bin/python /opt/upwatch/worker.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/upwatch
CapabilityBoundingSet=
AmbientCapabilities=
[Install]
WantedBy=multi-user.target
